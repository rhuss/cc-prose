", "source": "spex@spex-plugin-development"}, {"name": "superpowers", "path": "/Users/rhuss/.claude/plugins/cache/claude-plugins-official/superpowers/5.0.7", "source": "superpowers@claude-plugins-official"}, {"name": "blog", "path": "/Users/rhuss/Development/context-engineering/cc-blog/blog", "source": "blog@blog-plugin-development"}, {"name": "prose", "path": "/Users/rhuss/Development/context-engineering/cc-prose/prose", "source": "prose@prose-plugin-development"}, {"name": "agent-eval-harness", "path": "/Users/rhuss/Development/context-engineering/agent-eval-harness/", "source": "agent-eval-harness@agent-eval-harness-dev"}], "analytics_disabled": true, "uuid": "f69ca620-9558-4890-bb40-2073255f2a64", "memory_paths": {"auto": "/Users/rhuss/.claude/projects/-private-var-folders-3v-16m6pn090hl4d60grm1057ww0000gn-T-agent-eval-2026-05-04-opus-v2-cases-case-009-conversational-sycophantic/memory/"}, "fast_mode_state": "off", "timestamp": "2026-05-04T16:32:42.128Z"}
